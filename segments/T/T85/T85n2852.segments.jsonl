{"unit_id":"T85n2852_001","lb_range":["1301a01","1301a02","1301a03","1301a04","1301a05","1301a06"],"text_zh":"","text_en":"No. 2852 入布薩堂說偈文等 持戒清淨如滿月 身口皎潔無瑕穢","type":"prose","confidence":1}
{"unit_id":"T85n2852_002","lb_range":["1301a07"],"text_zh":"持戒清淨如滿月　身口皎潔無瑕穢 清淨和合無違諍　爾乃可得同布薩","text_en":"清淨和合無違諍 爾乃可得同布薩","type":"verse","confidence":1}
{"unit_id":"T85n2852_003","lb_range":["1301a08","1301a09"],"text_zh":"","text_en":"受水偈文 八功德水淨諸塵 灌掌去垢心無染","type":"prose","confidence":1}
{"unit_id":"T85n2852_004","lb_range":["1301a10"],"text_zh":"八功德水淨諸塵　灌掌去垢心無染 奉持禁戒無缺犯　一切眾生悉如是","text_en":"奉持禁戒無缺犯 一切眾生悉如是","type":"verse","confidence":1}
{"unit_id":"T85n2852_005","lb_range":["1301a11","1301a12"],"text_zh":"","text_en":"浴籌說偈文 羅漢聖僧集 凡夫眾和合","type":"prose","confidence":1}
{"unit_id":"T85n2852_006","lb_range":["1301a13"],"text_zh":"羅漢聖僧集　凡夫眾和合 香湯浴淨　布薩度眾生","text_en":"香湯浴淨 布薩度眾生","type":"verse","confidence":1}
{"unit_id":"T85n2852_007","lb_range":["1301a14","1301a15"],"text_zh":"","text_en":"受香湯說偈文 香水勳沐澡諸垢 法身具足五分充","type":"prose","confidence":1}
{"unit_id":"T85n2852_008","lb_range":["1301a16"],"text_zh":"香水勳沐澡諸垢　法身具足五分充 般若圓照解脫滿　群生同會法界融","text_en":"般若圓照解脫滿 群生同會法界融","type":"verse","confidence":1}
{"unit_id":"T85n2852_009","lb_range":["1301a17","1301a18"],"text_zh":"","text_en":"唱行香說偈文 戒香定香解脫香 光明雲臺遍世界","type":"prose","confidence":1}
{"unit_id":"T85n2852_010","lb_range":["1301a19"],"text_zh":"戒香定香解脫香　光明雲臺遍世界 供養十方無量佛　見聞普勳證寂滅","text_en":"供養十方無量佛 見聞普勳證寂滅","type":"verse","confidence":1}
{"unit_id":"T85n2852_011","lb_range":["1301a20","1301a21"],"text_zh":"","text_en":"受籌說偈文 金剛無礙解脫籌 難□□□□□菓","type":"prose","confidence":1}
{"unit_id":"T85n2852_012","lb_range":["1301a22"],"text_zh":"金剛無礙解脫籌　難□□□□□菓 我今歡喜頂戴受　一切眾生悉如是","text_en":"我今歡喜頂戴受 一切眾生悉如是","type":"verse","confidence":1}
{"unit_id":"T85n2852_013","lb_range":["1301a23","1301a24"],"text_zh":"","text_en":"還籌偈文 具足清淨受此籌 具足清淨還此籌","type":"prose","confidence":1}
{"unit_id":"T85n2852_014","lb_range":["1301a25"],"text_zh":"具足清淨受此籌　具足清淨還此籌 堅持禁戒無缺犯　一切眾生悉如是","text_en":"堅持禁戒無缺犯 一切眾生悉如是","type":"verse","confidence":1}
{"unit_id":"T85n2852_015","lb_range":["1301a26","1301a27"],"text_zh":"","text_en":"清淨妙偈文 清淨如滿月 清淨應布薩","type":"prose","confidence":1}
{"unit_id":"T85n2852_016","lb_range":["1301a28"],"text_zh":"清淨如滿月　清淨應布薩 身口業清淨　爾乃同布薩","text_en":"身口業清淨 爾乃同布薩","type":"verse","confidence":1}
{"unit_id":"T85n2852_017","lb_range":["1301a29","1301b01"],"text_zh":"","text_en":"布薩竟說偈文 諸佛出世第一快 聞法奉行歡喜快","type":"prose","confidence":1}
{"unit_id":"T85n2852_018","lb_range":["1301b02"],"text_zh":"諸佛出世第一快　聞法奉行歡喜快 大眾和合寂滅快　眾生離苦安樂快","text_en":"大眾和合寂滅快 眾生離苦安樂快","type":"verse","confidence":1}
